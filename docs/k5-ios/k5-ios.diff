+class KxStyleSet final : public SkFontStyleSet {
+public:
+    explicit KxStyleSet(sk_sp<SkTypeface> tf) : f(std::move(tf)) {}
+    int count() override { return 1; }
+    void getStyle(int, SkFontStyle* fs, SkString* name) override {
+        *fs = f->fontStyle();
+        if (name) name->set("");
+    }
+    sk_sp<SkTypeface> createTypeface(int) override { return f; }
+    sk_sp<SkTypeface> matchStyle(const SkFontStyle&) override { return f; }
+
+private:
+    sk_sp<SkTypeface> f;
+};
