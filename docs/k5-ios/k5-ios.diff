+int kx_fonts_family_index(const kx_fonts* f, const char* name) {
+    if (!f || !name) return -1;
+    const auto& fams = f->mgr->families();
+    for (size_t i = 0; i < fams.size(); ++i)
+        if (fams[i].equals(name)) return (int)i;
+    return -1;
