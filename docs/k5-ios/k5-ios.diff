+class KxFontMgr final : public SkFontMgr {
+public:
+    explicit KxFontMgr(sk_sp<SkFontMgr> factory) : fFactory(std::move(factory)) {}
+
+    sk_sp<SkTypeface> add(SkData* data) {
+        sk_sp<SkTypeface> tf = fFactory->makeFromData(sk_ref_sp(data));
+        if (tf) {
+            fFaces.push_back(tf);
+            SkString fam;
+            tf->getFamilyName(&fam);
+            fFamilies.push_back(fam);
+        }
+        return tf;
+    }
+    int countFaces() const { return (int)fFaces.size(); }
+    const std::vector<SkString>& families() const { return fFamilies; }
+
+protected:
+    int onCountFamilies() const override { return (int)fFaces.size(); }
+    void onGetFamilyName(int index, SkString* name) const override {
+        fFaces[SkToSizeT(index)]->getFamilyName(name);
+    }
+    sk_sp<SkFontStyleSet> onCreateStyleSet(int index) const override {
+        return sk_make_sp<KxStyleSet>(fFaces[SkToSizeT(index)]);
+    }
+    sk_sp<SkFontStyleSet> onMatchFamily(const char familyName[]) const override {
+        if (!familyName) return nullptr;
+        for (auto& f : fFaces) {
+            SkString n;
+            f->getFamilyName(&n);
+            if (n.equals(familyName)) return sk_make_sp<KxStyleSet>(f);
+        }
+        return nullptr;
+    }
+    sk_sp<SkTypeface> onMatchFamilyStyle(const char familyName[],
+                                         const SkFontStyle&) const override {
+        if (!familyName) return nullptr;
+        for (auto& f : fFaces) {
+            SkString n;
+            f->getFamilyName(&n);
+            if (n.equals(familyName)) return f;
+        }
+        return nullptr;
+    }
+    sk_sp<SkTypeface> onMatchFamilyStyleCharacter(const char familyName[],
+                                                  const SkFontStyle& style,
+                                                  const char*[], int,
+                                                  SkUnichar ch) const override {
+        if (auto tf = this->onMatchFamilyStyle(familyName, style)) {
+            if (tf->unicharToGlyph(ch)) return tf;
+        }
+        for (auto& f : fFaces) {
+            if (f->unicharToGlyph(ch)) return f;
+        }
+        return nullptr;
+    }
+    sk_sp<SkTypeface> onMakeFromData(sk_sp<SkData> data, int ttcIndex) const override {
+        return fFactory->makeFromData(std::move(data), ttcIndex);
+    }
+    sk_sp<SkTypeface> onMakeFromStreamIndex(std::unique_ptr<SkStreamAsset> s,
+                                            int i) const override {
+        return fFactory->makeFromStream(std::move(s), i);
+    }
+    sk_sp<SkTypeface> onMakeFromStreamArgs(std::unique_ptr<SkStreamAsset> s,
+                                           const SkFontArguments& a) const override {
+        return fFactory->makeFromStream(std::move(s), a);
+    }
+    sk_sp<SkTypeface> onMakeFromFile(const char path[], int ttcIndex) const override {
+        return fFactory->makeFromFile(path, ttcIndex);
+    }
+    sk_sp<SkTypeface> onLegacyMakeTypeface(const char familyName[],
+                                           SkFontStyle style) const override {
+        return fFactory->legacyMakeTypeface(familyName, style);
+    }
+
+private:
+    sk_sp<SkFontMgr> fFactory;
+    std::vector<sk_sp<SkTypeface>> fFaces;
+    std::vector<SkString> fFamilies;
+};
