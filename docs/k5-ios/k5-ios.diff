+kx_target* kx_target_offscreen(kx_ctx* c, int w, int h) {
+    if (!c || w <= 0 || h <= 0) return nullptr;
+    auto* t = new kx_target();
+    t->ctx = c;
+    t->w = w;
+    t->h = h;
+    SkImageInfo info = SkImageInfo::Make(w, h, kRGBA_8888_SkColorType,
+                                       kPremul_SkAlphaType,
+                                       SkColorSpace::MakeSRGB());
+    switch (c->backend) {
+        case KX_BACKEND_RASTER:
+            t->surface = SkSurfaces::Raster(info);
+            break;
+        case KX_BACKEND_GRAPHITE_METAL:
+            t->surface = SkSurfaces::RenderTarget(c->recorder.get(), info);
+            break;
+        default:
+            delete t;
+            return nullptr;
+    }
+    if (!t->surface) {
+        delete t;
+        return nullptr;
+    }
+    return t;
+}
