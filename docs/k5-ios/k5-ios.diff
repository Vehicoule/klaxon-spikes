+kx_ctx* kx_ctx_create_graphite_metal() {
+    auto* c = new kx_ctx();
+    c->backend = KX_BACKEND_GRAPHITE_METAL;
+
+    c->mtl_device = kx_mtl_create_device();
+    if (!c->mtl_device) {
+        delete c;
+        return nullptr;
+    }
+    c->mtl_queue = kx_mtl_create_queue(c->mtl_device);
+    if (!c->mtl_queue) {
+        delete c;
+        return nullptr;
+    }
+
+    skgpu::graphite::MtlBackendContext bc;
+    bc.fDevice.reset((CFTypeRef)c->mtl_device);   // prend possession du retain
+    bc.fQueue.reset((CFTypeRef)c->mtl_queue);
+    c->gctx = skgpu::graphite::ContextFactory::MakeMetal(bc, {});
+    if (!c->gctx) {
+        delete c;
+        return nullptr;
+    }
+    c->recorder = c->gctx->makeRecorder();
+
+    char* name = (char*)kx_mtl_device_name(c->mtl_device);
+    c->driver = std::string("graphite-metal(") + (name ? name : "?") + ")";
+    if (name) free(name);
+    return c;
+}
