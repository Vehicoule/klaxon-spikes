+int kx_fonts_add(kx_fonts* f, const void* data, size_t len) {
+    if (!f || !data || !len) return -1;
+    sk_sp<SkData> d = SkData::MakeWithCopy(data, len);
+    auto tf = f->mgr->add(d.get());
+    if (!tf) return -1;
+    f->dirty = true;
+    return f->mgr->countFaces() - 1;
+}
