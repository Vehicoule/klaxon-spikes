+// ---------------------------------------------------------------------------
+// Cible onscreen Metal (K1 macOS) : SDL_Metal_CreateView → CAMetalLayer.
+// La SkSurface wrappe le drawable COURANT : acquise à la 1re écriture,
+// relâchée au present (un drawable ne se recycle pas).
+// ---------------------------------------------------------------------------
+kx_target* kx_target_onscreen_metal(kx_ctx* c, void* ca_metal_layer, int w,
+                                    int h, double scale) {
+    if (!c || !ca_metal_layer || c->backend != KX_BACKEND_GRAPHITE_METAL ||
+        w <= 0 || h <= 0)
+        return nullptr;
+    auto* t = new kx_target();
+    t->ctx = c;
+    t->w = w;
+    t->h = h;
+    t->onscreen = true;
+    t->mtl_layer = kx_mtl_layer_configure(ca_metal_layer, c->mtl_device,
+                                        (double)w, (double)h, scale);
+    if (!t->mtl_layer) {
+        delete t;
+        return nullptr;
+    }
+    return t;
+}
+
+// Acquiert un drawable + wrappe sa texture en SkSurface. Idempotent par frame.
+int kx_metal_acquire(kx_target* t) {
+    if (!t || t->surface || !t->mtl_layer) return t && t->surface ? 0 : -1;
+    kx_ctx* c = t->ctx;
+    t->mtl_drawable = kx_mtl_layer_next_drawable(t->mtl_layer);
+    if (!t->mtl_drawable) return -1;  // pool plein — réessayer plus tard
+    void* tex = kx_mtl_drawable_texture(t->mtl_drawable);
+    auto backendTex = skgpu::graphite::BackendTextures::MakeMetal(
+        {t->w, t->h}, (CFTypeRef)tex);
+    t->surface = SkSurfaces::WrapBackendTexture(
+        c->recorder.get(), backendTex, SkColorSpace::MakeSRGB(), nullptr);
+    if (!t->surface) {
+        kx_mtl_release(t->mtl_drawable);
+        t->mtl_drawable = nullptr;
+        return -2;
+    }
+    return 0;
+}
+
+// Present : submit puis presentDrawable, relâche drawable + surface.
+int kx_metal_present(kx_target* t) {
+    if (!t || !t->mtl_layer) return -1;
+    if (!t->mtl_drawable) return 0;  // rien rendu — rien à présenter
+    int rc = kx_flush_target(t->ctx, t);
+    if (rc) {
+        // même en échec de flush on présente (noir) et on libère la frame
+    }
+    kx_ctx* c = t->ctx;
+    kx_mtl_present_drawable(c->mtl_queue, t->mtl_drawable);
+    kx_mtl_release(t->mtl_drawable);
+    t->mtl_drawable = nullptr;
+    t->surface.reset();
+    return rc;
+}
+
+void kx_target_free(kx_target* t) {
+    if (!t) return;
+    t->surface.reset();
+    if (t->mtl_drawable) { kx_mtl_release(t->mtl_drawable); t->mtl_drawable = nullptr; }
+    if (t->mtl_layer) { kx_mtl_release(t->mtl_layer); t->mtl_layer = nullptr; }
+    delete t;
+}
+
+void kx_target_size(const kx_target* t, int* w, int* h) {
+    if (w) *w = t->w;
+    if (h) *h = t->h;
+}
+
+// Flush/submit d'une cible après dessin (le "finalize" du backend).
+int kx_flush_target(kx_ctx* c, kx_target* t) {
+    if (!t || !t->dirty) return 0;
+    (void)c; // c == t->ctx (signature canonique partagée avec kx_skia_linux.cpp)
+    switch (c->backend) {
+        case KX_BACKEND_GRAPHITE_METAL: {
+            std::unique_ptr<skgpu::graphite::Recording> rec = c->recorder->snap();
+            if (!rec) return -1;
+            skgpu::graphite::InsertRecordingInfo info;
+            info.fRecording = rec.get();
+            if (c->gctx->insertRecording(info) != skgpu::graphite::InsertStatus::kSuccess)
+                return -2;
+            if (!c->gctx->submit()) return -3;
+            c->submitted_once = true;
+            break;
+        }
+        default:
+            break;  // raster : rien à faire
+    }
+    t->dirty = false;
+    return 0;
+}
+
+int kx_present(kx_ctx* c, kx_target* t) {
+    if (t && t->mtl_layer && c->backend == KX_BACKEND_GRAPHITE_METAL)
+        return kx_metal_present(t);
+    return kx_flush_target(c, t);
+}
