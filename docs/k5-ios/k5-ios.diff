+// ---------------------------------------------------------------------------
+// Image corpus : damier 64×64 déterministe uploadé en texture backend.
+// ---------------------------------------------------------------------------
+static SkBitmap make_corpus_bitmap() {
+    SkBitmap bm;
+    bm.allocPixels(SkImageInfo::Make(64, 64, kRGBA_8888_SkColorType,
+                                     kPremul_SkAlphaType));
+    uint32_t* px = (uint32_t*)bm.getPixels();
+    for (int y = 0; y < 64; ++y)
+        for (int x = 0; x < 64; ++x) {
+            bool alt = ((x >> 3) ^ (y >> 3)) & 1;
+            px[y * 64 + x] = alt ? 0xFF1E88E5 : 0xFFFFB300;
+        }
+    bm.setImmutable();
+    return bm;
+}
+
+sk_sp<SkImage> kx_ctx_corpus_image(kx_ctx* c) {
+    if (c->corpus_img_tried) return c->corpus_img;
+    c->corpus_img_tried = true;
+    SkBitmap bm = make_corpus_bitmap();
+    sk_sp<SkImage> raster = bm.asImage();
+    switch (c->backend) {
+        case KX_BACKEND_GRAPHITE_METAL:
+            c->corpus_img = SkImages::TextureFromImage(c->recorder.get(),
+                                                       raster.get(), {});
+            break;
+        default:
+            c->corpus_img = raster;
+    }
+    return c->corpus_img;
+}
+
+// ---------------------------------------------------------------------------
+// Readback (natif : polling OK / sync autorisé)
+// ---------------------------------------------------------------------------
+struct kx_readback {
+    kx_ctx* ctx;
+    kx_target* target;
+    bool done = false;
+    bool failed = false;
+    std::vector<uint8_t> pixels;
+    size_t row_bytes = 0;
+};
+
+kx_readback* kx_readback_start(kx_ctx* c, kx_target* t) {
+    if (!c || !t || !t->surface) return nullptr;
+    if (t->mtl_layer) return nullptr;  // drawable framebufferOnly : pas de readPixels
+    auto* rb = new kx_readback();
+    rb->ctx = c;
+    rb->target = t;
+    const size_t rbBytes = (size_t)t->w * 4;
+    rb->pixels.resize(rbBytes * t->h);
+    rb->row_bytes = rbBytes;
+    SkImageInfo info = SkImageInfo::Make(t->w, t->h, kRGBA_8888_SkColorType,
+                                         kPremul_SkAlphaType);
+
+    if (kx_flush_target(t->ctx, t)) {
+        rb->failed = true;
+        return rb;
+    }
+
+    switch (c->backend) {
+        case KX_BACKEND_RASTER:
+            if (t->surface->readPixels(info, rb->pixels.data(), rbBytes, 0, 0))
+                rb->done = true;
+            else
+                rb->failed = true;
+            break;
+        case KX_BACKEND_GRAPHITE_METAL: {
+            struct Ctx { kx_readback* rb; size_t rbBytes; int w, h; };
+            auto* ud = new Ctx{rb, rbBytes, t->w, t->h};
+            c->gctx->asyncRescaleAndReadPixels(
+                t->surface.get(), info, SkIRect::MakeWH(t->w, t->h),
+                SkImage::RescaleGamma::kSrc, SkImage::RescaleMode::kNearest,
+                [](SkImage::ReadPixelsContext uc,
+                   std::unique_ptr<const SkImage::AsyncReadResult> res) {
+                    std::unique_ptr<Ctx> ud(reinterpret_cast<Ctx*>(uc));
+                    if (res && res->count() >= 1) {
+                        const uint8_t* src = (const uint8_t*)res->data(0);
+                        size_t srcRb = res->rowBytes(0);
+                        for (int y = 0; y < ud->h; ++y)
+                            memcpy(ud->rb->pixels.data() + y * ud->rbBytes,
+                                   src + y * srcRb, ud->rbBytes);
+                        ud->rb->done = true;
+                    } else {
+                        ud->rb->failed = true;
+                    }
+                },
+                ud);
+            // Natif : sync autorisé — submit bloquant fait le callback.
+            c->gctx->submit(skgpu::graphite::SyncToCpu::kYes);
+            break;
+        }
+        default:
+            rb->failed = true;
+    }
+    return rb;
+}
+
+int kx_readback_poll(kx_ctx*, kx_readback* rb) {
+    if (!rb) return -1;
+    if (rb->failed) return -1;
+    return rb->done ? 1 : 0;
+}
+
+int kx_readback_copy(const kx_readback* rb, uint8_t* dst) {
+    if (!rb || !rb->done) return -1;
+    memcpy(dst, rb->pixels.data(), rb->pixels.size());
+    return (int)rb->pixels.size();
+}
+
+int64_t kx_readback_copy_n(const kx_readback* rb, void* dst, size_t len) {
+    if (!rb || !rb->done || !dst) return -1;
+    size_t n = rb->pixels.size() < len ? rb->pixels.size() : len;
+    memcpy(dst, rb->pixels.data(), n);
+    return (int64_t)n;
+}
+
+void kx_readback_free(kx_readback* rb) { delete rb; }
+
+// ---------------------------------------------------------------------------
+// Bench : iters × (kx_scene_draw + flush/submit + readback) — le "chemin
+// complet" du spec KX (le readback natif inclut la complétion GPU).
+// ---------------------------------------------------------------------------
+double kx_bench_ms(kx_ctx* c, kx_fonts* f, kx_target* t, int scene, int iters) {
+    if (!c || !t || iters <= 0) return -1;
+    auto t0 = std::chrono::steady_clock::now();
+    for (int i = 0; i < iters; ++i) {
+        if (kx_scene_draw(c, f, t, scene, (double)(i % 60) / 60.0)) return -1;
+        if (kx_flush_target(t->ctx, t)) return -1;
+        kx_readback* rb = kx_readback_start(c, t);
+        if (!rb) return -1;
+        int spins = 0;
+        while (kx_readback_poll(c, rb) == 0 && ++spins < 100000)
+            ;
+        kx_readback_free(rb);
+    }
+    auto t1 = std::chrono::steady_clock::now();
+    return std::chrono::duration<double, std::milli>(t1 - t0).count();
+}
