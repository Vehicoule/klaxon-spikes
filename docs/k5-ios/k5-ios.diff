+// Internes pour kx_scenes.cpp.
+skia::textlayout::FontCollection* kx_fonts_collection(kx_fonts* f) {
+    if (!f) return nullptr;
+    if (f->dirty || !f->collection) {
+        auto fc = sk_make_sp<skia::textlayout::FontCollection>();
+        fc->setDefaultFontManager(f->mgr, f->mgr->families());
+        f->collection = std::move(fc);
+        f->dirty = false;
+    }
+    return f->collection.get();
+}
+const std::vector<SkString>* kx_fonts_families(kx_fonts* f) {
